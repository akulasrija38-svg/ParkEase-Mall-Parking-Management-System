# =============================================================================
# ParkEase – Environment Variables
# Copy this file to ".env" and fill in all required values before running.
# NEVER commit the .env file to version control.
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# When using docker-compose this is auto-wired. Override for cloud Atlas:
# SPRING_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parking_system?retryWrites=true&w=majority
SPRING_MONGODB_URI=mongodb://mongodb:27017/parking_system
MONGODB_DATABASE=parking_system

# ─── Admin Bootstrap ─────────────────────────────────────────────────────────
# The admin account is created/updated on every startup if these are set.
# Must be at least 12 characters.
PARKEASE_ADMIN_EMAIL=admin@parkease.com
PARKEASE_ADMIN_PASSWORD=ChangeThisSecure123!
PARKEASE_ADMIN_NAME=ParkEase Admin

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_APP_LEVEL=INFO
LOG_CONFIG_LEVEL=INFO
LOG_MONGO_LEVEL=INFO
LOG_ROOT_LEVEL=INFO
